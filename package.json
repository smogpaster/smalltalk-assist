{
  "name": "smalltalk-assist",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:device": "NO_HMR=1 vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "simulate": "evenhub-simulator http://localhost:5180",
    "simulate:auto": "evenhub-simulator --automation-port 9898 http://localhost:5180",
    "qr": "evenhub qr --http --port 5180",
    "pack": "npm run build && evenhub pack app.json dist -o smalltalk-assist.ehpk"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@evenrealities/even_hub_sdk": "^0.0.16",
    "@evenrealities/pretext": "^0.1.4",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.1.14",
    "@evenrealities/evenhub-simulator": "^0.9.5",
    "@types/node": "^22.20.4",
    "jsdom": "^30.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
